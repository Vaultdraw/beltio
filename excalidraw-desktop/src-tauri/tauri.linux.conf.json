{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "title": "Vaultdraw",
        "width": 1280,
        "height": 850,
        "minWidth": 760,
        "minHeight": 560,
        "incognito": true,
        "create": false,
        "dragDropEnabled": false
      }
    ]
  },
  "bundle": {
    "targets": ["deb", "appimage"],
    "linux": {
      "deb": {
        "section": "graphics",
        "priority": "optional",
        "depends": ["libpoppler-glib8"]
      },
      "rpm": {
        "depends": ["poppler-glib"]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
