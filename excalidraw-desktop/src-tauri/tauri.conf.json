{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vaultdraw",
  "mainBinaryName": "excalidraw-vault",
  "version": "0.1.1",
  "identifier": "app.vaultdraw",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && node scripts/build-cli.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Vaultdraw",
        "width": 1280,
        "height": 850,
        "minWidth": 760,
        "minHeight": 560,
        "incognito": true,
        "create": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false,
        "trafficLightPosition": {
          "x": 14,
          "y": 22
        }
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: asset:; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost vdthumb: http://vdthumb.localhost data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline' vdplugin: http://vdplugin.localhost; script-src 'self' 'wasm-unsafe-eval' 'sha256-dlVP/8hLKT3yhwEll4jkPqIPe1aQphBq9dmOlX7keIk=' vdplugin: http://vdplugin.localhost; worker-src 'self' blob:; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "externalBin": ["binaries/vaultdraw"],
    "resources": {
      "../../LICENSE": "licenses/Excalidraw-MIT.txt"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {}
}
