{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vaultdraw",
  "mainBinaryName": "excalidraw-vault",
  "version": "0.2.0",
  "identifier": "app.vaultdraw",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && node scripts/build-cli.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Vaultdraw",
        "width": 1280,
        "height": 850,
        "minWidth": 760,
        "minHeight": 560,
        "incognito": true,
        "create": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false,
        "trafficLightPosition": {
          "x": 14,
          "y": 22
        }
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: asset:; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost vdthumb: http://vdthumb.localhost data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline' vdplugin: http://vdplugin.localhost; script-src 'self' 'wasm-unsafe-eval' 'sha256-8lAFP6TonNzdJTBUQZsAVha6+NLZ+7CWYHKQ2wjh10c=' vdplugin: http://vdplugin.localhost; worker-src 'self' blob:; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "externalBin": ["binaries/vaultdraw"],
    "resources": {
      "../../LICENSE": "licenses/Excalidraw-MIT.txt",
      "../../plugins/official/markdown-import/dist": "plugins/markdown-import",
      "../../plugins/official/gallery/dist": "plugins/gallery",
      "../../plugins/official/graph/dist": "plugins/graph",
      "../../plugins/official/mermaid/dist": "plugins/mermaid",
      "../../plugins/official/formula/dist": "plugins/formula",
      "../../plugins/official/pdf-import/dist": "plugins/pdf-import",
      "../../plugins/official/favourites/dist": "plugins/favourites",
      "../../plugins/official/auto-export/dist": "plugins/auto-export",
      "../../plugins/official/table/dist": "plugins/table"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "fileAssociations": [
      {
        "ext": ["excalidraw"],
        "name": "Excalidraw drawing",
        "description": "Excalidraw drawing",
        "mimeType": "application/vnd.excalidraw+json",
        "role": "Editor",
        "rank": "Alternate",
        "exportedType": {
          "identifier": "app.vaultdraw.excalidraw",
          "conformsTo": ["public.json"]
        }
      },
      {
        "ext": ["excalidrawlib"],
        "name": "Excalidraw library",
        "description": "Excalidraw library",
        "mimeType": "application/vnd.excalidrawlib+json",
        "role": "Viewer",
        "rank": "Alternate",
        "exportedType": {
          "identifier": "app.vaultdraw.excalidrawlib",
          "conformsTo": ["public.json"]
        }
      }
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {}
}
