{
 "_doc": "Golden cases for vaultdraw_core::uri::parse (Rust, uri/tests.rs). ok = the request serialized as the window plan; err = UriError::code(). legacyFile = what the in-drawing link decoder decodeVaultUrl (src/links/linkUri.ts) returns for the same input: asserted by src/links/linkUri.test.ts so the two cannot drift.",
 "cases": [
  {
   "name": "bare",
   "input": "vaultdraw://",
   "ok": {
    "action": "focus"
   }
  },
  {
   "name": "bare slash",
   "input": "vaultdraw:///",
   "ok": {
    "action": "focus"
   }
