{
  "name": "excalidraw-desktop",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "Vaultdraw \u2014 offline Tauri 2 desktop shell around the real Excalidraw editor. User-selected filesystem vault; no cloud, telemetry, or accounts.",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 1420",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "docs:config": "vite-node --config ../vitest.config.mts scripts/gen-config-reference.ts",
    "test:e2e": "playwright test",
    "test:e2e:full": "E2E_FULL=1 playwright test",
    "test:fast": "node scripts/test-tier.mjs fast",
    "test:merge": "node scripts/test-tier.mjs merge",
    "test:milestone": "node scripts/test-tier.mjs milestone"
  },
  "dependencies": {
    "@codemirror/commands": "^6.0.0",
    "@codemirror/language": "^6.0.0",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@replit/codemirror-vim": "^6.4.0",
    "@tauri-apps/api": "^2.12.2",
    "dompurify": "^3.2.5",
    "katex": "^0.16.22",
    "marked": "^16.2.1",
    "mathjax-full": "3.2.2",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tauri-apps/cli": "^2.12.1",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "3.1.0",
    "sass": "1.51.0",
    "typescript": "5.9.3",
    "vite": "5.0.12",
    "vite-node": "3.0.6",
    "vitest": "3.0.6"
  }
}
